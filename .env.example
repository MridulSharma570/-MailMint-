# ============================================================================
# MailMint ✉️🌿 — Optional Server-Side Free AI API Keys
# Developers: Anmolpreet Singh & Mridul Sharma
#
# NOTE: Users can also enter their own free API keys directly inside the
# MailMint website UI (stored safely in browser localStorage).
# Setting any key below is completely optional and serves as a server fallback.
# ============================================================================

# 1. Google Gemini (Free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 2. Groq Cloud (Free at https://console.groq.com/keys)
GROQ_API_KEY=

# 3. OpenRouter (Free at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 4. Mistral AI (Free at https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# 5. Cohere (Free Trial at https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=

# Server Configuration
PORT=5000
FLASK_DEBUG=false
